---
interface Props {
	text?: string;
}

const { text = "normal" } = Astro.props;
const layers = [4, 3, 2, 1, 0] as const;
const display = text.trim().toLowerCase() || "normal";
const markChars = Math.max(display.length, 2);
---

<div class="brand-wordmark-wrap" style={`--mark-chars: ${markChars}`} aria-hidden="true">
	<div class="brand-wordmark-stack">
		{
			layers.map((layer) => (
				<p class:list={["brand-wordmark", layer === 0 && "brand-wordmark--face"]} data-layer={layer}>
					{display}
				</p>
			))
		}
	</div>
</div>

<style>
	.brand-wordmark-wrap {
		pointer-events: none;
		position: absolute;
		inset: 0;
		z-index: 0;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		overflow: hidden;
		user-select: none;
	}

	.brand-wordmark-stack {
		position: relative;
		width: 100%;
		--layer-step: clamp(1.05rem, 2.6vw, 2.6rem);
		mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0.12) 0%,
			rgba(0, 0, 0, 0.5) 22%,
			#000 58%,
			#000 100%
		);
	}

	.brand-wordmark {
		margin: 0;
		width: 100%;
		font-family: var(--font-display);
		font-weight: 600;
		line-height: 0.7;
		letter-spacing: -0.055em;
		text-align: center;
		white-space: nowrap;
		color: rgba(243, 241, 234, 0.1);
		-webkit-text-stroke: 1.4px rgba(243, 241, 234, 0.16);
		paint-order: stroke fill;
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		transform: translateY(calc(var(--layer, 0) * var(--layer-step)));
		z-index: calc(10 - var(--layer, 0));
		font-size: calc(100vw / max(3.4, calc(var(--mark-chars, 10) * 0.52)));
	}

	.brand-wordmark[data-layer="0"] {
		--layer: 0;
		position: relative;
		color: rgba(243, 241, 234, 0.14);
		-webkit-text-stroke: 1.6px rgba(243, 241, 234, 0.28);
	}

	.brand-wordmark[data-layer="1"] {
		--layer: 1;
		color: rgba(200, 197, 188, 0.1);
		-webkit-text-stroke: 1.4px rgba(200, 197, 188, 0.22);
	}

	.brand-wordmark[data-layer="2"] {
		--layer: 2;
		color: rgba(150, 148, 140, 0.08);
		-webkit-text-stroke: 1.35px rgba(160, 158, 150, 0.2);
	}

	.brand-wordmark[data-layer="3"] {
		--layer: 3;
		color: rgba(100, 100, 96, 0.07);
		-webkit-text-stroke: 1.2px rgba(120, 120, 114, 0.18);
	}

	.brand-wordmark[data-layer="4"] {
		--layer: 4;
		color: rgba(60, 60, 56, 0.09);
		-webkit-text-stroke: 1.2px rgba(90, 90, 86, 0.2);
	}

	@media (min-width: 768px) {
		.brand-wordmark {
			-webkit-text-stroke-width: 1.85px;
		}

		.brand-wordmark[data-layer="0"] {
			color: rgba(243, 241, 234, 0.16);
			-webkit-text-stroke: 2px rgba(243, 241, 234, 0.34);
		}
	}
</style>
