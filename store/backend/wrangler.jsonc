{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "97b0dab10c55d2e8a6c952eb4e4914ac",
  "name": "thenormal-shop-backend",
  "workers_dev": true,
  "preview_urls": true,
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "admin1.thenormal.space",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "MedusaServer",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDUSA",
        "class_name": "MedusaServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MedusaServer"
      ]
    }
  ],
  "vars": {
    "STORE_CORS": "https://shop.thenormal.space",
    "ADMIN_CORS": "https://admin1.thenormal.space",
    "AUTH_CORS": "https://shop.thenormal.space,https://admin1.thenormal.space",
    "MEDUSA_BACKEND_URL": "https://admin1.thenormal.space",
    "MEDUSA_WORKER_MODE": "shared",
    "DISABLE_MEDUSA_ADMIN": "false",
    "S3_BUCKET": "thenormal-shop-media",
    "S3_FILE_URL": "https://media.thenormal.space",
    "S3_ENDPOINT": "https://97b0dab10c55d2e8a6c952eb4e4914ac.r2.cloudflarestorage.com",
    "S3_REGION": "auto",
    "SHOP_API_URL": "https://api.thenormal.space",
    "JUMPCLOUD_ISSUER": "https://oauth.id.jumpcloud.com",
    "JUMPCLOUD_REDIRECT_URI": "https://admin1.thenormal.space/app/login",
    "CLERK_ISSUER": "https://clerk.thenormal.space",
    "CLERK_AUTHORIZED_PARTIES": "https://shop.thenormal.space,https://clerk.thenormal.space"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a343d6a97eac4e378b42ae3535a72a52"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "thenormal-shop-media"
    }
  ]
}
