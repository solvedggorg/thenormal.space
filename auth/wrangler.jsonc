{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "97b0dab10c55d2e8a6c952eb4e4914ac",
  "name": "thenormal-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "auth.thenormal.space",
      "custom_domain": true
    }
  ],
  "vars": {
    "ISSUER": "https://auth.thenormal.space",
    "RP_NAME": "The Normal Space",
    "MAIL_FROM": "auth@thenormal.space",
    "MAIL_FROM_NAME": "The Normal Space",
    "ADMIN_ORIGIN": "https://admin2.thenormal.space",
    "ALLOW_DCR": "false"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thenormal-auth",
      "database_id": "db1e8933-c9e7-472a-aab8-d04e16a37d5c",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "138a985967e14d52aeaafd053c0cb131"
    }
  ]
}
