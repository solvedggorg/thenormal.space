{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thenormal-auth-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  // Access app thenormal-auth-admin (74716ad6-736d-4a30-b715-afc3c904d3b5)
  // Same policy as thenormal-shop-admin: Cloudflare IdP, account members only.
  "routes": [
    {
      "pattern": "admin2.thenormal.space",
      "custom_domain": true
    }
  ],
  "vars": {
    "ISSUER": "https://auth.thenormal.space",
    "MAIL_FROM": "auth@thenormal.space",
    "MAIL_FROM_NAME": "The Normal Space",
    "TEAM_DOMAIN": "https://iresolved-llc.cloudflareaccess.com",
    "POLICY_AUD": "0f92ae489e149699ab84a95de2f574e1ed778ffe94c3c2b9e041b95c14ca4860",
    "RP_NAME": "The Normal Space",
    "JUMPCLOUD_ISSUER": "https://oauth.id.jumpcloud.com",
    "JUMPCLOUD_REDIRECT_URI": "https://admin2.thenormal.space/oidc/callback"
  },
  "access": {
    "dev": {
      "aud": "0f92ae489e149699ab84a95de2f574e1ed778ffe94c3c2b9e041b95c14ca4860",
      "identity": { "email": "dev@thenormal.space" }
    }
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thenormal-auth",
      "database_id": "8ca7a0e3-9c51-4a25-97c9-b8ab3f73788c",
      "migrations_dir": "../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "efbd77d5dc30489ca956e5c642686e90"
    }
  ]
}
